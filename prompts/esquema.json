{  "$schema": "http://json-schema.org/draft-07/schema#",  "title": "ContratoCriteriosAceptacion",  "type": "object",  "required": ["id_historia", "es_invest_valida", "criterios_aceptacion", "advertencias"],  "additionalProperties": false,  "properties": {    "id_historia": { "type": "string", "pattern": "^HU-[0-9]{2}$" },    "es_invest_valida": { "type": "boolean" },    "criterios_aceptacion": {      "type": "array",      "minItems": 0,      "items": {        "type": "object",        "required": ["id", "tipo", "dado", "cuando", "entonces"],        "additionalProperties": false,        "properties": {          "id": { "type": "string", "pattern": "^CA-[0-9]{2}$" },          "tipo": { "type": "string", "enum": ["positivo", "negativo", "borde"] },          "dado": { "type": "string", "minLength": 10 },          "cuando": { "type": "string", "minLength": 10 },          "entonces": { "type": "string", "minLength": 10 }        }      }    },    "advertencias": {      "type": "array",      "items": { "type": "string" }    }  }}
