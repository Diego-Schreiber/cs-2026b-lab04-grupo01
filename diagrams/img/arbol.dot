digraph ArbolUtilidad {    rankdir=LR;    node [shape=box, fontname="Helvetica", fontsize=10, style=filled, fillcolor="#F4F6F9", color="#1B365D"];    edge [color="#4A777A"];    Utilidad [label="Utilidad de CitaSalud Arequipa", fillcolor="#1B365D", fontcolor="white", shape=oval, fontsize=12];    Rendimiento [label="Rendimiento", fillcolor="#4A777A", fontcolor="white"];    Disponibilidad [label="Disponibilidad", fillcolor="#4A777A", fontcolor="white"];    Seguridad [label="Seguridad", fillcolor="#4A777A", fontcolor="white"];    Modificabilidad [label="Modificabilidad", fillcolor="#4A777A", fontcolor="white"];    Utilidad -> {Rendimiento Disponibilidad Seguridad Modificabilidad};    QA01 [label="QA-01: Reservas Pico 07:00 AM\n(p95 < 250ms, 0% overbooking)\n[H, H]", fillcolor="#E8F1F5"];    QA02 [label="QA-02: Búsqueda Médicos Caché\n(p99 < 100ms a 10k req/min)\n[H, M]", fillcolor="#E8F1F5"];    Rendimiento -> {QA01 QA02};    QA03 [label="QA-03: Fallo WhatsApp -> Fallback SMS\n(Conmutación < 2.0s, 0% pérdida)\n[H, H]", fillcolor="#E8F1F5"];    QA04 [label="QA-04: Failover BD Principal\n(RTO < 30s, RPO < 1s)\n[H, M]", fillcolor="#E8F1F5"];    Disponibilidad -> {QA03 QA04};    QA05 [label="QA-05: Aislamiento Multi-clínica\n(0 fuga de datos, RLS + HTTP 403)\n[H, H]", fillcolor="#E8F1F5"];    QA06 [label="QA-06: Guardrails LLM Asistente\n(Filtrado < 50ms, 0 diagnósticos)\n[H, M]", fillcolor="#E8F1F5"];    Seguridad -> {QA05 QA06};    QA07 [label="QA-07: Nuevo Canal Telegram\n(Integración < 4 hrs-hombre)\n[M, M]", fillcolor="#E8F1F5"];    QA08 [label="QA-08: Reemplazo Motor Caché\n(Cambio en 1 adaptador)\n[M, L]", fillcolor="#E8F1F5"];    Modificabilidad -> {QA07 QA08};}
